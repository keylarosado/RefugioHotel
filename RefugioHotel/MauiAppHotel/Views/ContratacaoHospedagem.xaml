<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="Reservar" BackgroundColor="{StaticResource Sand}">
    <ScrollView>
        <VerticalStackLayout Padding="22,28" Spacing="18">
            <VerticalStackLayout Spacing="5">
                <Label Text="Sua hospedagem" FontSize="27" FontFamily="OpenSansSemibold"
                       HorizontalTextAlignment="Start"/>
                <Label Text="Preencha os detalhes para planejar sua estadia."
                       FontSize="13" TextColor="{StaticResource Muted}"
                       HorizontalTextAlignment="Start"/>
            </VerticalStackLayout>

            <Border BackgroundColor="White" Stroke="#E8E3D9" StrokeThickness="1"
                    Padding="18" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="16">
                    <Label Text="HÓSPEDES" FontSize="11" CharacterSpacing="1.4"
                           TextColor="{StaticResource Forest}" HorizontalTextAlignment="Start"/>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="12">
                        <Label Text="Adultos" Grid.Row="0" Grid.Column="0" VerticalTextAlignment="Center"/>
                        <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="10">
                            <Label Text="{Binding Value, Source={x:Reference stpAdultos}}" VerticalTextAlignment="Center"
                                   TextColor="{StaticResource Forest}" FontFamily="OpenSansSemibold"/>
                            <Stepper x:Name="stpAdultos" Minimum="1" Maximum="8" Increment="1" Value="2"
                                     WidthRequest="115"/>
                        </HorizontalStackLayout>
                        <Label Text="Crianças" Grid.Row="1" Grid.Column="0" VerticalTextAlignment="Center"/>
                        <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="10">
                            <Label Text="{Binding Value, Source={x:Reference stpCriancas}}" VerticalTextAlignment="Center"
                                   TextColor="{StaticResource Forest}" FontFamily="OpenSansSemibold"/>
                            <Stepper x:Name="stpCriancas" Minimum="0" Maximum="6" Increment="1" Value="0"
                                     WidthRequest="115"/>
                        </HorizontalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#EEEAE2"/>
                    <Label Text="ACOMODAÇÃO" FontSize="11" CharacterSpacing="1.4"
                           TextColor="{StaticResource Forest}" HorizontalTextAlignment="Start"/>
                    <Picker x:Name="pckQuarto" Title="Selecione sua acomodação"
                            ItemsSource="{Binding Acomodacoes}" SelectedIndex="0"
                            ItemDisplayBinding="{Binding Nome}"/>
                    <Label Text="{Binding AcomodacaoSelecionada.Descricao}"
                           FontSize="12" TextColor="{StaticResource Muted}"
                           HorizontalTextAlignment="Start"/>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Stroke="#E8E3D9" StrokeThickness="1"
                    Padding="18" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="13">
                    <Label Text="PERÍODO DA ESTADIA" FontSize="11" CharacterSpacing="1.4"
                           TextColor="{StaticResource Forest}" HorizontalTextAlignment="Start"/>
                    <Label Text="Check-in" FontSize="12" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Start"/>
                    <DatePicker x:Name="dtpCheckin" Format="dd/MM/yyyy" MinimumDate="{Binding Hoje}"
                                Date="{Binding Checkin, Mode=TwoWay}"/>
                    <Label Text="Check-out" FontSize="12" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Start"/>
                    <DatePicker x:Name="dtpCheckout" Format="dd/MM/yyyy"
                                MinimumDate="{Binding DataMinimaCheckout}"
                                Date="{Binding Checkout, Mode=TwoWay}"/>
                    <Label Text="{Binding ResumoPeriodo}" FontSize="12"
                           TextColor="{StaticResource Forest}" HorizontalTextAlignment="Start"/>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#E6EDE5" StrokeThickness="0" Padding="16"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="5">
                    <Label Text="ESTIMATIVA DA DIÁRIA" FontSize="10" CharacterSpacing="1"
                           TextColor="{StaticResource Forest}" HorizontalTextAlignment="Start"/>
                    <Label Text="{Binding ValorEstimado, StringFormat='R$ {0:N2} / noite'}"
                           FontSize="22" FontFamily="OpenSansSemibold"
                           HorizontalTextAlignment="Start"/>
                    <Label Text="Valor ilustrativo, sujeito à confirmação." FontSize="10"
                           TextColor="{StaticResource Muted}" HorizontalTextAlignment="Start"/>
                </VerticalStackLayout>
            </Border>

            <Button Text="Continuar reserva  →" BackgroundColor="{StaticResource Forest}"
                    TextColor="White" Clicked="OnAvancarClicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
