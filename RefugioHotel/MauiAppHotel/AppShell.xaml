<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiAppHotel.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiAppHotel"
    xmlns:views="clr-namespace:MauiAppHotel.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F5F2EC">
    <TabBar>
        <ShellContent Title="Início"
                      ContentTemplate="{DataTemplate local:MainPage}"
                      Route="MainPage" />
        <ShellContent Title="Reservar"
                      ContentTemplate="{DataTemplate views:ContratacaoHospedagem}"
                      Route="ContratacaoHospedagem" />
        <ShellContent Title="Sobre"
                      ContentTemplate="{DataTemplate views:Sobre}"
                      Route="Sobre" />
    </TabBar>
</Shell>
